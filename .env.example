# ---- FBOSINT Analyzer configuration (copy to .env or set as environment variables) ----
# Mode: local (127.0.0.1 only) | network (LAN server)
FBO_MODE=local
FBO_HOST=127.0.0.1
FBO_PORT=8765
# Data directory (default: %APPDATA%\FBOSINT on Windows, ~/.fbosint elsewhere)
# FBO_DATA_DIR=
# Database: SQLite by default; PostgreSQL for centralized network deployments
# FBO_DATABASE_URL=postgresql+psycopg://fbosint:CHANGE_ME@localhost:5432/fbosint
# Fernet key for encrypting stored credentials. If empty a key file is generated in the data dir.
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FBO_ENCRYPTION_KEY=
# TLS for network mode (fbosint gen-cert --ip <server-ip>)
FBO_TLS_CERTFILE=
FBO_TLS_KEYFILE=
# FBO_COOKIE_SECURE=true
# FBO_CORS_ORIGINS=   (only needed if the web UI is served from another origin)
# ---- Meta Graph API (can also be set in Settings, where they are stored encrypted) ----
FBO_META_APP_ID=
FBO_META_APP_SECRET=
FBO_META_ACCESS_TOKEN=
FBO_META_GRAPH_VERSION=v23.0
FBO_META_REDIRECT_URI=http://127.0.0.1:8765/api/meta/oauth/callback
# ---- Security / limits ----
FBO_SESSION_TTL_HOURS=12
FBO_SESSION_IDLE_MINUTES=60
FBO_RATE_LIMIT_PER_MINUTE=240
FBO_LOGIN_RATE_LIMIT_PER_MINUTE=10
FBO_LOGIN_MAX_FAILURES=5
FBO_LOGIN_LOCKOUT_MINUTES=15
FBO_RETENTION_DAYS=365
FBO_BACKUP_INTERVAL_HOURS=24
FBO_BACKUP_KEEP=14
FBO_MAX_POSTS=200
FBO_HTTP_TIMEOUT=15
# FBO_UPDATE_MANIFEST_URL=https://your-server/fbosint/latest.json
